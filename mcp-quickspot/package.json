{
  "name": "quickspot-mcp",
  "version": "0.1.0",
  "description": "MCP server to list/create/update/delete QuickSpot actions from any AI agent (local stdio, edits quickspot.config.json)",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "quickspot-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "mcpb/manifest.json",
    "README.md",
    "INSTALL.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "node scripts/e2e-check.mjs",
    "smoke": "node scripts/check-bundle.mjs",
    "check": "npm run typecheck && npm test && npm run build && npm run e2e && npm run smoke",
    "pack-mcpb": "node scripts/pack-mcpb.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
