{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QuickSpot",
  "version": "0.2.0",
  "identifier": "dev.quickspot.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "QuickSpot",
        "width": 520,
        "height": 580,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false,
        "shadow": false,
        "backgroundColor": [
          0,
          0,
          0,
          0
        ]
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "createUpdaterArtifacts": true,
    "macOS": {
      "signingIdentity": "-"
    },
    "shortDescription": "Spotlight-style quick-action launcher",
    "longDescription": "A round, always-on-top quick launcher with a global hotkey and actions that orbit a central hub.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg0NTIxOTVDN0M2MTlEMApSV1RRR2NiSGxTRkZDQlE3V3NuRCtNQ0s2OG1MVkZnYnpWN0J5STRMRk85ak9KOWFqWElFejlGTgo=",
      "endpoints": [
        "https://github.com/Cayetano97/QuickSpot/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}